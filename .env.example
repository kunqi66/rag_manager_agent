# ============================================================
# RAG 知识库管理平台 —— 环境变量模板
#
# 用法：cp .env.example .env，然后填掉所有 <必填> 项。
# ⚠️ .env 已在 .gitignore 中，绝不要提交。
#
# 注意：DATABASE_URL / REDIS_URL / CELERY_* 不在此配置，
#       它们由下面的分段字段派生（见 backend/core/settings.py），
#       避免分段值与整串值不一致。
# ============================================================

# ---------- 应用 ----------
# 仅用于日志与 OpenAPI 标题，改了不影响行为。
APP_NAME=RAG 知识库管理平台
# dev | production。production 会强制校验下方所有密钥，缺失则拒绝启动。
APP_ENV=dev
API_PORT=8000
LOG_LEVEL=INFO
# 本地 Vite dev server 的跨域来源，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- MySQL ----------
# 本地开发直连阿里云时，把 host 改成 ECS 公网 IP；
# 容器内运行时由 docker-compose 覆盖为服务名 mysql。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=rag_kb
MYSQL_USER=rag
MYSQL_PASSWORD=<必填>
MYSQL_ROOT_PASSWORD=<必填，仅 docker-compose 初始化用>

# ---------- Milvus ----------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=kb_chunk

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<必填>
REDIS_DB_CACHE=0
REDIS_DB_BROKER=1
REDIS_DB_RESULT=2

# ---------- Milvus 依赖的 MinIO ----------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=<必填，改成随机串>

# ---------- 认证 ----------
# 生产必须是 32 位以上随机串：openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ---------- 外部服务 ----------
MINERU_API_BASE=https://mineru.net/api/v4
MINERU_API_TOKEN=<必填>
MINERU_POLL_TIMEOUT_SECONDS=900

# 开发期指向本机 4060 上部署的 BGE 服务；
# 生产期改为公司 GPU 服务器的内网地址（PRD D17）。
EMBEDDING_BASE_URL=http://127.0.0.1:9997/v1
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=120
# 🔴 BGE 的查询侧指令前缀。**只加在问题侧**（be-05 检索），
#    文档片段侧一律不加（be-04 导入）—— 两边都加或都不加会让相似度整体偏移，
#    且不报任何错，只表现为「检索效果莫名其妙变差」。
EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：

DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=<必填>
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TEMPERATURE=0.3

# ---------- 切片与检索 ----------
CHUNK_MAX_TOKENS=512
CHUNK_MIN_TOKENS=32
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
RETRIEVAL_PREFETCH_RATIO=3
KB_MIN_SCORE=0.4

# ---------- 检索问答（be-05）----------
# 多轮对话带上的历史轮数（1 轮 = 用户 + 助手 2 条）。
QA_HISTORY_ROUNDS=3
# 会话标题取首问的前 N 字（字典 §2.3）。
QA_SESSION_TITLE_CHARS=20
# 「受限探测」结果的缓存秒数。只省一次 Milvus 调用，缓存失效不影响正确性。
QA_PROBE_CACHE_SECONDS=60
# 会话列表 / 详情的 page_size 上限（字典 §2.3 的 page_size_max）。
QA_PAGE_SIZE_MAX=100

# ---------- 沉淀挖掘（be-08）----------
FAQ_CLUSTER_SIMILARITY=0.85
FAQ_MIN_FREQUENCY=5
FAQ_MATCH_THRESHOLD=0.92
MINING_LOOKBACK_DAYS=7
# 置信度 = 平均相似度 × min(1, 频次 / 本值)
FAQ_CONFIDENCE_FREQ_REF=20
# 进程内 FAQ 索引兜底全量重载周期（秒）
FAQ_CACHE_RELOAD_INTERVAL_SECONDS=300
# 候选 / FAQ 列表分页上限
FAQ_PAGE_SIZE_MAX=100
# 🔴 手动挖掘的自限耗时（秒），**必须小于前端 http.ts 的 15 s 全局超时**
FAQ_MINE_SYNC_MAX_SECONDS=10

# ---------- 知识缺口（be-09）----------
# 每轮缺口聚合的回溯窗口（小时）。beat 每 10 分钟一轮，窗口比间隔宽是**刻意**的：
# 重叠部分靠缺口自身的 last_seen_at 水位线去重，晚到的日志还能被下一轮捞到。
GAP_AGGREGATE_LOOKBACK_HOURS=3
# 是否自动把 tasked 缺口置 closed。关闭不可逆，觉得吵就设 false（改由人工收口）。
GAP_AUTO_CLOSE_ENABLED=true
# 缺口清单分页上限
GAP_PAGE_SIZE_MAX=200
# 🔴 分类推荐的独立超时（秒），刻意远小于 DEEPSEEK_TIMEOUT_SECONDS：
#    它是可选装饰，卡顿不该占满整轮聚合的预算。
GAP_LLM_SUGGEST_TIMEOUT_SECONDS=5

# ---------- 安全开关 ----------
# 开启后权限缺失提示会附带受限文档标题。
# ⚠️ 这会泄漏「存在某份敏感文档」这一事实（PRD §6.2.4 / R9），
#    仅演示场景临时打开，生产保持 false。
ACL_REVEAL_BLOCKED_TITLES=false

# ═══════════════════════════════════════════════════════════════
# 以下各段是**回填**（2026-10-14）。
#
# 🔴 它们一直只存在于 `backend/core/settings.py` 的默认值里 ——
#    be-02 / be-04 / be-06 加配置时没同步到本文件，而 CLAUDE.md 明写
#    「.env.example 是所有环境变量的完整清单（唯一事实来源）」。
#    症状：运维照本文件配 `.env`，**配了个寂寞** —— 缺的那些项静默走默认值，
#    没有任何报错（pydantic-settings 的 `extra="ignore"` 连拼错的键都不报）。
#    `verify_stats.py` 的 T1-60 现在会盯这条，别让它再漂。
#
# ⚠️ 键名是**全大写**（`case_sensitive=False`），值写成 settings.py 里
#    小写字段名的对应物 —— 两处形态不同是刻意的，不是笔误。
# ═══════════════════════════════════════════════════════════════

# ---------- 组织域（be-02）----------
# 部门移动时 MySQL 命名锁的等待秒数，取不到锁直接报错而不是无限等。
ORG_DEPT_LOCK_TIMEOUT_SECONDS=5
# 用户列表 page_size 上限。
ORG_USER_PAGE_SIZE_MAX=100

# ---------- 知识导入（be-04）----------
# 单文件与批量上传的体积/数量闸（安全红线 5 的配套：解压前先卡住输入）。
UPLOAD_MAX_FILE_MB=200
UPLOAD_BATCH_MAX_FILES=50
# MinerU 返回的 zip 解压后**总字节**上限，防 zip 炸弹。
ZIP_MAX_UNCOMPRESSED_MB=2048
# MinerU 是异步 API，轮询间隔从初始值指数退避到上限。
MINERU_POLL_INTERVAL_INITIAL_SECONDS=3
MINERU_POLL_INTERVAL_MAX_SECONDS=30
# 导入任务的重试退避：countdown = min(cap, base * factor ** retries)。
# ⚠️ 这三个是**自己算**的，不走 Celery 的 retry_backoff（对手动 self.retry 静默无效）。
IMPORT_RETRY_MAX=3
IMPORT_RETRY_BACKOFF_BASE=60
IMPORT_RETRY_BACKOFF_CAP=900
IMPORT_RETRY_BACKOFF_FACTOR=5
# 文档台账列表 page_size 上限。
KB_PAGE_SIZE_MAX=100
# Milvus 索引类型与距离度量。换 metric 必须**同时重建 collection**
# （已入库的向量是按旧 metric 归一化的），否则检索结果静默变差。
MILVUS_INDEX_TYPE=AUTOINDEX
MILVUS_METRIC_TYPE=COSINE
# BGE 模型下载源（仅 embedding 服务的部署机需要）。
HF_ENDPOINT=https://hf-mirror.com

# ---------- 审计（be-06）----------
# 审计行保留天数。审计页默认只查最近 7 天，老数据留 180 天备查。
AUDIT_RETENTION_DAYS=180
# 删审计行时的**伪造检测**窗口（秒）：同一用户在同一 document 上重复读，
# 窗口内的第二次不重复留痕 —— 否则前端每翻一页就多一行，把审计表冲成噪音。
AUDIT_READ_DEDUP_SECONDS=300
# 审计列表 page_size 上限与默认时间范围。
AUDIT_PAGE_SIZE_MAX=100
AUDIT_DEFAULT_RANGE_DAYS=7
# 分批删除的批量与重试退避（理由同上，一次 DELETE 几十万行会持锁）。
AUDIT_PURGE_BATCH_SIZE=5000
AUDIT_PURGE_RETRY_BACKOFF_BASE=60
AUDIT_PURGE_RETRY_BACKOFF_CAP=600
# 🔴 是否信任 `X-Real-IP`。默认 true 是因为部署形态就是 nginx 反代
#    （nginx 覆盖写入，客户端伪造不了）；**直连暴露 API 端口时必须置 false**，
#    否则手填一个 header 就能把审计 IP 写成任意值，审计作为证据就废了。
AUDIT_TRUST_PROXY_IP=true

# ---------- 运营看板（be-07）----------
# 每轮聚合回溯的小时数（兜 qa_log 的跨桶迟到行）。
STATS_LOOKBACK_HOURS=3
# 不传时间参数时的默认窗口（天）。
STATS_DEFAULT_RANGE_DAYS=7
# 每桶 TOP 榜条数，**同时是接口 `limit` 的上限**。
STATS_TOP_N=50
# 延时直方图桶边界（毫秒，逗号分隔，**最后一个为开区间**）。
# ⚠️ 用逗号串而不是 JSON 数组：pydantic-settings 对 list 型要求 `[0,200]` 字面量，
#    写进 .env 极易漏引号，而漏了会**静默**按默认值走。
STATS_LATENCY_EDGES_MS=0,200,500,1000,2000,5000
# 小时桶保留天数（日表默认永久，见下）。
STATS_HOURLY_RETENTION_DAYS=90
# 🔴 日表保留天数。**0 = 永久保留**，此时清理任务完全不碰日表。
#    别改成 0 以下的负数或误以为 0 表示「不保留」—— 日表是长期趋势的唯一来源。
STATS_DAILY_RETENTION_DAYS=0
# 清理分批与重试退避（理由同审计）。
STATS_PURGE_BATCH_SIZE=5000
STATS_PURGE_RETRY_BACKOFF_BASE=60
STATS_PURGE_RETRY_BACKOFF_CAP=600
# granularity=hour 的最大跨度（小时表保留期有限，且 8760 个点前端画不动）。
STATS_HOUR_RANGE_MAX_DAYS=7
# 任意查询的最大跨度。
STATS_QUERY_MAX_DAYS=365
# 选表阈值：窗口 ≤ 此小时数查 stats_hourly（更细），否则查 stats_daily（更省）。
STATS_HOUR_TABLE_MAX_HOURS=48
# `top-knowledge` 的角色硬闸（安全红线 4 的第二道闸）。
# ⚠️ 该端点返回文档标题；若哪天把 `stats:dashboard:view` 授给 staff，
#    只有这道闸还拦得住，且拦成的是响亮的 403 而不是安静的标题泄漏。
STATS_ADMIN_ROLE_CODES=sys_admin,kb_admin
