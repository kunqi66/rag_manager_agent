# ============================================================
# RAG 知识库管理平台 —— 环境变量模板
#
# 用法：cp .env.example .env，然后填掉所有 <必填> 项。
# ⚠️ .env 已在 .gitignore 中，绝不要提交。
#
# 注意：DATABASE_URL / REDIS_URL / CELERY_* 不在此配置，
#       它们由下面的分段字段派生（见 backend/core/settings.py），
#       避免分段值与整串值不一致。
# ============================================================

# ---------- 应用 ----------
# dev | production。production 会强制校验下方所有密钥，缺失则拒绝启动。
APP_ENV=dev
API_PORT=8000
LOG_LEVEL=INFO
# 本地 Vite dev server 的跨域来源，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- MySQL ----------
# 本地开发直连阿里云时，把 host 改成 ECS 公网 IP；
# 容器内运行时由 docker-compose 覆盖为服务名 mysql。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=rag_kb
MYSQL_USER=rag
MYSQL_PASSWORD=<必填>
MYSQL_ROOT_PASSWORD=<必填，仅 docker-compose 初始化用>

# ---------- Milvus ----------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=kb_chunk

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<必填>
REDIS_DB_CACHE=0
REDIS_DB_BROKER=1
REDIS_DB_RESULT=2

# ---------- Milvus 依赖的 MinIO ----------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=<必填，改成随机串>

# ---------- 认证 ----------
# 生产必须是 32 位以上随机串：openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ---------- 外部服务 ----------
MINERU_API_BASE=https://mineru.net/api/v4
MINERU_API_TOKEN=<必填>
MINERU_POLL_TIMEOUT_SECONDS=900

# 开发期指向本机 4060 上部署的 BGE 服务；
# 生产期改为公司 GPU 服务器的内网地址（PRD D17）。
EMBEDDING_BASE_URL=http://127.0.0.1:9997/v1
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32

DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=<必填>
DEEPSEEK_MODEL=deepseek-chat

# ---------- 切片与检索 ----------
CHUNK_MAX_TOKENS=512
CHUNK_MIN_TOKENS=32
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
RETRIEVAL_PREFETCH_RATIO=3
KB_MIN_SCORE=0.4

# ---------- 沉淀挖掘 ----------
FAQ_CLUSTER_SIMILARITY=0.85
FAQ_MIN_FREQUENCY=5
FAQ_MATCH_THRESHOLD=0.92
MINING_LOOKBACK_DAYS=7

# ---------- 安全开关 ----------
# 开启后权限缺失提示会附带受限文档标题。
# ⚠️ 这会泄漏「存在某份敏感文档」这一事实（PRD §6.2.4 / R9），
#    仅演示场景临时打开，生产保持 false。
ACL_REVEAL_BLOCKED_TITLES=false
